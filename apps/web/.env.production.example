# --- Production env for the deployed web app (e.g. GCP Cloud Run) ---
# Set these on the Cloud Run service (NOT committed). Copy/fill as needed.

# Backend Kotlin API base URL. The web server proxies /api/* here (server-side).
# Point this at the deployed API (Cloud Run service URL or custom domain).
API_BASE_URL=https://<couple-calendar-api>.run.app

# Disable in-browser API mocking in production (must NOT be "enabled").
NEXT_PUBLIC_API_MOCKING=disabled

# Long random string used to encrypt the session cookie (server-only). REQUIRED.
# Generate e.g.: openssl rand -base64 48
SESSION_SECRET=__set_a_long_random_secret__

# Auth cookie name (optional; defaults handled in code).
AUTH_COOKIE_NAME=cc-auth

# --- Sign in with Apple (web) ---
# Apple "Services ID" (web), and the HTTPS return URL registered for it.
# The redirect URI MUST match the deployed domain + /login.
NEXT_PUBLIC_APPLE_CLIENT_ID=com.woobottle.couplecalendarWeb
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://<your-web-domain>/login
