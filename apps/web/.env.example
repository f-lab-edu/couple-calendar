# Public — exposed to the browser bundle
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server-only — read in RSC / route handlers / middleware
API_BASE_URL=http://localhost:8080
AUTH_COOKIE_NAME=cc-auth

# Session cookie encryption secret (server-only). Use a long random string in prod.
SESSION_SECRET=change-me

# MSW (Mock Service Worker) — set to `enabled` for dev mocking,
# leave unset (or any other value) to hit the real backend.
NEXT_PUBLIC_API_MOCKING=enabled

# --- Sign in with Apple (web) ---
# Apple Developer "Services ID" (NOT the native App ID). Public — shipped in the browser bundle.
# When BOTH of the below are set, the login page loads Apple's JS SDK and acquires a real id_token.
# When unset, the login page falls back to a dev mock token (works only with MSW mocking enabled).
NEXT_PUBLIC_APPLE_CLIENT_ID=com.couplecalendar.web
# Return URL registered in the Apple Services ID config. Must be HTTPS in production.
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://localhost:3000/login
