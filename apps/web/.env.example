# Public — exposed to the browser bundle
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server-only — read in RSC / route handlers / middleware
API_BASE_URL=http://localhost:8080
AUTH_COOKIE_NAME=cc-auth

# MSW (Mock Service Worker) — set to `enabled` for dev mocking,
# leave unset (or any other value) to hit the real backend.
NEXT_PUBLIC_API_MOCKING=enabled
